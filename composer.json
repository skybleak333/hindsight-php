{
    "name": "fedoseev/hindsight-php",
    "description": "PHP client for Hindsight agent memory, with long-term memory for Laravel AI SDK agents, Laravel MCP servers, Symfony AI agents and Neuron AI agents.",
    "keywords": [
        "hindsight",
        "agent memory",
        "ai",
        "llm",
        "laravel",
        "laravel-ai",
        "mcp",
        "memory",
        "neuron-ai",
        "rag",
        "symfony",
        "symfony-ai"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/skybleak333/hindsight-php",
    "authors": [
        {
            "name": "Andrei Fedoseev",
            "homepage": "https://github.com/skybleak333"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "laravel/ai": "^1.0",
        "laravel/mcp": "^1.0",
        "neuron-core/neuron-ai": "^4.1",
        "opis/json-schema": "^2.4",
        "opis/string": "^2.0.1",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/ai-agent": "^0.15 || ^1.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0"
    },
    "suggest": {
        "laravel/ai": "Long-term memory middleware and tools for Laravel AI SDK agents (^1.0).",
        "laravel/mcp": "Memory tools for Laravel MCP servers (^1.0).",
        "symfony/ai-agent": "Long-term memory for Symfony AI agents (^0.15 or ^1.0).",
        "symfony/http-kernel": "HindsightBundle, to configure the client in a Symfony app (^7.3 or ^8.0).",
        "neuron-core/neuron-ai": "Memory tools for Neuron AI agents (^4.1)."
    },
    "autoload": {
        "psr-4": {
            "Fedoseev\\Hindsight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedoseev\\Hindsight\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fedoseev\\Hindsight\\Laravel\\HindsightServiceProvider"
            ],
            "aliases": {
                "Hindsight": "Fedoseev\\Hindsight\\Laravel\\Facades\\Hindsight"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit,laravel,symfony,neuron",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
