{
    "name": "fedoseev/hindsight-php",
    "description": "PHP client for Hindsight agent memory, with long-term memory for Laravel AI SDK agents.",
    "keywords": ["hindsight", "agent memory", "ai", "llm", "laravel", "laravel-ai", "memory", "rag"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/skybleak333/hindsight-php",
    "authors": [
        {
            "name": "Andrei Fedoseev",
            "homepage": "https://github.com/skybleak333"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "laravel/ai": "^1.0",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "laravel/ai": "Long-term memory middleware and tools for Laravel AI SDK agents (^1.0)."
    },
    "autoload": {
        "psr-4": {
            "Fedoseev\\Hindsight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedoseev\\Hindsight\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fedoseev\\Hindsight\\Laravel\\HindsightServiceProvider"
            ],
            "aliases": {
                "Hindsight": "Fedoseev\\Hindsight\\Laravel\\Facades\\Hindsight"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit,laravel",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
